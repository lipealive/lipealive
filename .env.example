# Copie para .env.local (não vai para o git). Sem estas variáveis o site usa os
# números de reserva de src/content/site.ts (`site.stats`), sem erro.

# Instagram Graph API (Business Discovery), seguidores dos 4 perfis.
# ID da conta Instagram Business/Creator que faz a consulta (não é o @, é o id numérico
# que aparece em me/accounts?fields=instagram_business_account).
META_IG_USER_ID=
# Token de acesso de longa duração da Meta com instagram_basic e pages_read_engagement
# (ou pages_show_list). O ideal é um token de System User do Business Manager, que não expira.
META_TOKEN=

# YouTube Data API v3 (Google Cloud > APIs > YouTube Data API v3 > Credenciais > Chave de API).
# Usada para inscritos e total de vídeos do canal. Os vídeos recentes vêm do RSS, sem chave.
YOUTUBE_API_KEY=

# Segredo da rota /api/revalidate (força atualizar os dados na hora). Sem ele a rota fica fechada.
# Gere com: openssl rand -hex 32
REVALIDATE_SECRET=
