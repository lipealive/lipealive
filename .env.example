# Copie para .env.local (não vai para o git). Sem estas variáveis o site usa os
# números de reserva de src/content/site.ts (`site.stats`), sem erro.

# Instagram Graph API: seguidores dos perfis ligados às páginas do portfólio (uma chamada em
# me/accounts). Perfil fora do portfólio fica no valor de reserva até ser adicionado.
# Token de System User do Business Manager (não expira) com instagram_basic, pages_show_list
# e pages_read_engagement.
META_TOKEN=
# Não usada por enquanto (era para o Business Discovery, que o app não tem permissão de usar).
META_IG_USER_ID=

# YouTube Data API v3 (Google Cloud > APIs > YouTube Data API v3 > Credenciais > Chave de API).
# Usada para inscritos e total de vídeos do canal. Os vídeos recentes vêm do RSS, sem chave.
YOUTUBE_API_KEY=

# Segredo da rota /api/revalidate (força atualizar os dados na hora). Sem ele a rota fica fechada.
# Gere com: openssl rand -hex 32
REVALIDATE_SECRET=
